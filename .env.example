# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Connection string for local PostgreSQL (from docker-compose.yml)
DATABASE_URL="postgresql://partnerflow_user:partnerflow_secret_password@localhost:5432/partnerflow_saas"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather for TedCloud Zero-Chat notifications & invite links
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# WHATSAPP_CLOUD_API: Meta WhatsApp Business Cloud API credentials for HSM template notifications
WHATSAPP_ACCESS_TOKEN="YOUR_WHATSAPP_CLOUD_ACCESS_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"


# TEDCLOUD_SESSION_SECRET: Secret for signing server session tokens (HMAC-SHA256) issued on login/registration.
# Required in production (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs out all users. In development a temporary per-process secret is used if unset.
TEDCLOUD_SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# TEDCLOUD_DATA_FILE: Fallback JSON store used only when Supabase/PostgreSQL is NOT configured.
# Default: ./data/tedcloud-store.json (data survives server restarts). Set to "off" to keep data in memory only.
# Not a replacement for a real database: single-process deployments, demos and local development only.
# TEDCLOUD_DATA_FILE="./data/tedcloud-store.json"
