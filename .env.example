# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Connection string for local PostgreSQL (from docker-compose.yml)
DATABASE_URL="postgresql://partnerflow_user:partnerflow_secret_password@localhost:5432/partnerflow_saas"
